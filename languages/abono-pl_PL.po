#. Plugin Name of the plugin
#: abono.php
msgid "Plogins Subscribe - Newsletter Signup for WooCommerce"
msgstr "Plogins Subscribe - Zapis do newslettera dla WooCommerce"

#. Plugin URI of the plugin
#: abono.php
msgid "https://plogins.com/plogins-subscribe/"
msgstr "https://plogins.com/plogins-subscribe/"

#. Description of the plugin
#: abono.php
msgid ""
"Add a newsletter opt-in at checkout and collect subscribers with consent."
msgstr ""
"Dodaj zapis do newslettera przy składaniu zamówienia i zbieraj subskrybentów "
"za ich zgodą."

#. Author of the plugin
#: abono.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: abono.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: abono.php:48
msgid "Plogins Subscribe for WooCommerce requires WooCommerce to be active."
msgstr "Plogins Subscribe dla WooCommerce wymaga aktywnego WooCommerce."

